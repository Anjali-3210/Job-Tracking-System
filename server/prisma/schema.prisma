generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}
datasource db {
  provider = "postgresql"
}

model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String

  jobs Job[]
}

model Job {
  id          Int      @id @default(autoincrement())
  company     String
  position    String
  status      String
  appliedDate DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id])
}
